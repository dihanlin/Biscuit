# Copy this file to .env and fill in your values
# Run: cp .env.example .env

# API key for the LLM safety judge, public figure classifier, and web search router.
# Claude Haiku is used by default. To swap providers, update the relevant calls in
# safety_filter.py, figure_classifier.py, and web_search.py.
#
# Anthropic (default): https://console.anthropic.com
# OpenAI: https://platform.openai.com
# Google (Gemini): https://aistudio.google.com
ANTHROPIC_API_KEY=your_api_key_here

# LLM provider for safety judge, public figure classifier, and web search router.
# Defaults to Anthropic (Claude Haiku). Swap to OpenAI or Google if preferred.
#
# Options: anthropic | openai | google
LLM_PROVIDER=anthropic

# Your API key for the chosen provider.
# If using Anthropic, you can use either ANTHROPIC_API_KEY or LLM_API_KEY.
LLM_API_KEY=your_api_key_here

# Optional: override the default model for your provider.
# Defaults: anthropic=claude-haiku-4-5-20251001, openai=gpt-4o-mini, google=gemini-1.5-flash
# LLM_MODEL=your_model_here
